datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model EwsIssue {
  id                 String     @id @default(uuid()) @db.Uuid
  title              String     @db.VarChar(500)
  description        String     @db.Text
  sourceName         String     @map("source_name") @db.VarChar(255)
  sourceUrl          String     @map("source_url") @db.Text
  sources            Json       @db.JsonB // Daftar media pendukung [{source_name, url}] untuk triangulasi
  status             String     @db.VarChar(50) // 'DRAFT_SEARCHED', 'VERIFIED_HOAX', 'VERIFIED_CREDIBLE', 'ANALYZED', 'MITIGATED', 'REPORTED'
  
  // Tahap 2: Evaluasi Kredibilitas / Cek Hoax
  isHoax             Boolean?   @map("is_hoax")
  verificationScore  Float?     @map("verification_score")
  verificationNotes  String?    @map("verification_notes") @db.Text
  
  // Tahap 3: Analisis Mendalam
  riskLevel          String?    @map("risk_level") @db.VarChar(50) // 'AMAN', 'WASPADA', 'KRITIS/MERAH'
  primaryCategory    String?    @map("primary_category") @db.VarChar(100)
  targetDistrict     String?    @map("target_district") @db.VarChar(255)
  analysisSummary    String?    @map("analysis_summary") @db.Text
  predictedImpact    String?    @map("predicted_impact") @db.Text
  
  // Tahap 4: Mitigasi & Rekomendasi OPD
  mitigationActions  Json?      @map("mitigation_actions") // Array of strings: ["Aksi 1", "Aksi 2"]
  responsibleOpd     String?    @map("responsible_opd") @db.VarChar(255)
  
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  
  AuditLogs          AuditLog[]

  @@map("ews_issues")
}

model SystemBaseline {
  id            String   @id @default(uuid()) @db.Uuid
  category      String   @unique @db.VarChar(100)
  baselineValue String   @map("baseline_value") @db.Text
  description   String   @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("system_baselines")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.VarChar(255)
  actionType String    @map("action_type") @db.VarChar(100)
  issueId    String?   @map("issue_id") @db.Uuid
  issue      EwsIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  notes      String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}
