# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Prisma supports pooling natively. Customize user, password, host, port, and database name.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brida_ews_db?schema=public&connection_limit=10"

# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key-here"
# Optional: OpenAI Model to use (default: gpt-4o-mini or gpt-4o for structured output support)
OPENAI_MODEL="gpt-4o-mini"
